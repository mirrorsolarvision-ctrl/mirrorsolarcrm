rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // 1. CORE AUTHENTICATION & ROLE HELPERS
    // ==========================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        getUserDoc().role == 'Admin' || 
        request.auth.token.role == 'Admin' ||
        request.auth.token.email in ['mirrorsolarvision@gmail.com', 'mirroraquaro@gmail.com', 'balajiperuri09@gmail.com']
      );
    }

    function isAccounts() {
      return isAuthenticated() && (
        getUserDoc().role == 'Accounts' ||
        getUserDoc().employeeCategory == 'Accounts' ||
        getUserDoc().category == 'Accounts' ||
        request.auth.token.role == 'Accounts'
      );
    }

    function isPaymentVerifier() {
      return isAdmin() || isAccounts();
    }

    function isEmployee() {
      return isAuthenticated() && (
        getUserDoc().role == 'Employee' || 
        request.auth.token.role == 'Employee'
      );
    }

    function isSalesManager() {
      return isEmployee() && (
        getUserDoc().employeeCategory in ['Sales Manager', 'Sales Manager (Telecaller)'] || 
        getUserDoc().category in ['Sales Manager', 'Sales Manager (Telecaller)'] ||
        getUserDoc().responsibilities.primaryResponsibilityId == 'resp_sales_manager'
      );
    }

    function isSuryaGharIncharge() {
      return isEmployee() && (
        getUserDoc().employeeCategory in ['PM Surya Ghar Work Incharge', 'PM Surya Ghar'] ||
        getUserDoc().category in ['PM Surya Ghar Work Incharge', 'PM Surya Ghar']
      );
    }

    function isStockIncharge() {
      return isEmployee() && (
        getUserDoc().employeeCategory == 'Stock Incharge' ||
        getUserDoc().category == 'Stock Incharge'
      );
    }

    function isDealer() {
      return isAuthenticated() && (
        getUserDoc().role == 'Dealer' || 
        request.auth.token.role == 'Dealer'
      );
    }

    // ==========================================
    // 2. USERS & ACCESS SECURITY
    // ==========================================
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      // Users can update basic profile info, but CANNOT self-promote role, permissions, or status
      allow update: if isAdmin() || (
        request.auth.uid == userId && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'phone', 'address', 'lastActive', 'avatar', 'availabilityStatus'
        ])
      );
    }

    match /dealers/{dealerId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ==========================================
    // 3. LEADS & CUSTOMER OPPORTUNITIES
    // ==========================================
    match /leads/{leadId} {
      // Scoped read access
      allow read: if isAuthenticated() && (
        isAdmin() || 
        isSalesManager() || 
        isAccounts() || 
        isSuryaGharIncharge() || 
        isStockIncharge() || 
        (isDealer() && (
          resource.data.dealerId == request.auth.uid
        )) ||
        (isEmployee() && (
          resource.data.assignedEmployeeId == request.auth.uid || 
          resource.data.leadOwnerId == request.auth.uid ||
          resource.data.assignedEmployeeEmail == request.auth.token.email ||
          resource.data.assignedEmployeeId == getUserDoc().employeeId ||
          resource.data.assignedEmployee == getUserDoc().name
        ))
      );

      // Lead creation restricted to authorized roles
      allow create: if isAuthenticated() && (
        isAdmin() || isSalesManager() || isEmployee() || isAccounts()
      ) && (
        // Must initialize with valid baseline fields
        request.resource.data.keys().hasAll(['customer', 'phone', 'stage', 'createdAt']) &&
        // Non-admins cannot set installation approval at creation
        (!('installationApprovalStatus' in request.resource.data) || request.resource.data.installationApprovalStatus == 'None') &&
        // Non-payment-verifiers cannot set paymentVerificationStatus to Verified at creation
        (!('paymentVerificationStatus' in request.resource.data) || request.resource.data.paymentVerificationStatus != 'Verified' || isPaymentVerifier()) &&
        // Dealer allocation status must be None or Requested on create
        (!('dealerStatus' in request.resource.data) || request.resource.data.dealerStatus in ['None', 'Requested'] || isAdmin())
      );

      // Field-Level Update Allowlists
      allow update: if isAuthenticated() && (
        // A. Super Admin: Full operational authority
        isAdmin() || 

        // A2. Accounts Authority: Direct client SDK updates restricted to accounting notes/details
        // DEF-010: Direct client SDK writes CANNOT mark payments as Verified; trusted Cloud Function required
        (isAccounts() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'notes', 'updatedAt', 'accountsNotes', 'billingDetails', 'gstin'
          ])
        ) || 

        // B. Sales Manager: can edit sales fields, reassign leads, advance pipeline
        (isSalesManager() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'salesStage', 'stage', 'priority', 'followUp', 'notes', 'customer', 
            'phone', 'email', 'location', 'dealerSpecifications', 'leadScore',
            'reassignmentRequest', 'updatedAt', 'payments', 'dealer', 'dealerId', 'dealerName',
            'dealerCode', 'dealerStatus', 'quotationRequested', 'discountRequested',
            'assignedEmployeeId', 'assignedEmployee', 'assignedEmployeeEmail', 'leadOwnerId',
            'dealerRequestedAt', 'dealerRequestedBy', 'dealerNotes'
          ]) &&
          // Cannot unilaterally approve dealer allocation (must remain Requested or Pending)
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['dealerStatus']) ||
           request.resource.data.dealerStatus in ['Requested', 'Pending', 'None'] ||
           resource.data.dealerStatus == request.resource.data.dealerStatus ||
           isAdmin()
          ) &&
          // Cannot unilaterally verify customer payments
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['payments']) ||
           request.resource.data.payments.customerPayments == resource.data.payments.customerPayments ||
           request.resource.data.payments.customerPayments[request.resource.data.payments.customerPayments.size() - 1].status == 'Pending Verification'
          ) &&
          // Strict Pipeline Gate: Cannot advance to Booking Confirmed or Won without verified advance payment
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['stage', 'salesStage']) ||
           !(request.resource.data.stage in ['Converted', 'Installation'] || 
             request.resource.data.salesStage in ['Booking Confirmed', 'Project Handoff']) ||
           resource.data.paymentVerificationStatus == 'Verified' ||
           (resource.data.payments.customerPayments.size() > 0 && 
            resource.data.payments.customerPayments[0].status == 'Verified') ||
           isAdmin()
          ) &&
          // Cannot unilaterally approve installation
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['installationApprovalStatus']) ||
           request.resource.data.installationApprovalStatus == resource.data.installationApprovalStatus
          )
        ) ||

        // C. Telecaller: can only edit assigned lead's call, qualification, and sales progress
        (isEmployee() && (
          resource.data.assignedEmployeeId == request.auth.uid || 
          resource.data.leadOwnerId == request.auth.uid ||
          resource.data.assignedEmployeeEmail == request.auth.token.email ||
          resource.data.assignedEmployeeId == getUserDoc().employeeId ||
          resource.data.assignedEmployee == getUserDoc().name
        ) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'salesStage', 'stage', 'priority', 'followUp', 'notes', 'customer', 
            'phone', 'email', 'location', 'dealerSpecifications', 'leadScore',
            'updatedAt', 'payments', 'callNotes', 'callOutcome', 'customerResponseNotes',
            'monthlyUnits', 'sanctionedLoad', 'monthlyBill', 'roofType', 'roofArea',
            'qualificationScore', 'qualification', 'systemCapacityKw', 'dealerNotes'
          ]) &&
          // Cannot reassign lead ownership
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['assignedEmployeeId', 'leadOwnerId', 'assignedEmployee', 'dealerId'])) &&
          // Strict Pipeline Gate: Telecaller cannot advance to Booking Confirmed or Converted directly
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['stage', 'salesStage']) ||
           !(request.resource.data.stage in ['Converted', 'Installation'] || 
             request.resource.data.salesStage in ['Booking Confirmed', 'Project Handoff']) ||
           resource.data.paymentVerificationStatus == 'Verified' ||
           (resource.data.payments.customerPayments.size() > 0 && 
            resource.data.payments.customerPayments[0].status == 'Verified') ||
           isPaymentVerifier()
          ) &&
          // Cannot unilaterally verify customer payments
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['payments']) ||
           request.resource.data.payments.customerPayments == resource.data.payments.customerPayments ||
           request.resource.data.payments.customerPayments[request.resource.data.payments.customerPayments.size() - 1].status == 'Pending Verification'
          )
        ) ||

        // D. Dealer: can only submit technical site survey & document data for assigned dealer UID
        (isDealer() && (
          resource.data.dealerId == request.auth.uid
        ) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'dealerSpecifications', 'documents', 'updatedAt', 'notes', 
            'siteSurveyPhotos', 'siteSurveyNotes', 'technicalFeasibility'
          ])
        )
      );

      allow delete: if isAdmin();
    }

    // ==========================================
    // 3b. SEPARATE SENSITIVE DOCUMENT COLLECTIONS
    // ==========================================
    // Financial Data (Customer Bank Details, Gross Margin, Settlement)
    match /leadFinancials/{leadId} {
      allow read: if isAdmin() || isAccounts();
      allow write: if isPaymentVerifier();
    }

    // Sensitive Identity Documents (Aadhaar number, PAN, KYC validation tokens)
    // DEF-009: Strict KYC Upload & Read Authorization via lead assignment UIDs
    match /leadKyc/{leadId} {
      allow read: if isAuthenticated() && (
        isAdmin() || isSuryaGharIncharge() || (
          isEmployee() && (
            get(/databases/$(database)/documents/leads/$(leadId)).data.assignedEmployeeId == request.auth.uid ||
            get(/databases/$(database)/documents/leads/$(leadId)).data.leadOwnerId == request.auth.uid
          )
        )
      );
      allow write: if isAuthenticated() && (
        isAdmin() || isSuryaGharIncharge() || (
          isEmployee() && (
            get(/databases/$(database)/documents/leads/$(leadId)).data.assignedEmployeeId == request.auth.uid ||
            get(/databases/$(database)/documents/leads/$(leadId)).data.leadOwnerId == request.auth.uid
          )
        )
      );
    }

    // Internal Management Executive Notes & Margins
    match /leadManagement/{leadId} {
      allow read, write: if isAdmin() || isSalesManager();
    }

    // Rate limiting tracking for server-side brute force defense
    match /auth_attempts/{docId} {
      allow read: if true;
      // Protected creation: failedCount can only initialize to 1 with lockoutUntil set to 0
      allow create: if request.resource.data.failedCount == 1 &&
                       request.resource.data.lockoutUntil == 0;
      // Protected update: can only increment failedCount monotonically; cannot forge arbitrary lockout periods
      allow update: if isAdmin() || (
        request.resource.data.failedCount == resource.data.failedCount + 1 &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['failedCount', 'lockoutUntil', 'lastAttempt', 'sanitizedId']) &&
        ((request.resource.data.failedCount >= 5 && request.resource.data.lockoutUntil > resource.data.lockoutUntil) ||
         (request.resource.data.failedCount < 5 && request.resource.data.lockoutUntil == 0))
      );
      // Only administrators can clear or delete lockout documents
      allow delete: if isAdmin();
    }

    // DEF-012: Call-Log Identity, Write Protection, and Scoping
    match /call_leads/{callId} {
      // Sales management oversight + Telecaller own records only. Accounts access removed.
      allow read: if isAuthenticated() && (
        isAdmin() || isSalesManager() ||
        (isEmployee() && (
          resource.data.telecallerId == request.auth.uid ||
          resource.data.employeeId == request.auth.uid ||
          resource.data.assignedEmployeeId == request.auth.uid
        ))
      );
      // Identity Protection: Telecaller can only create call records under their own authenticated UID
      allow create: if isAuthenticated() && (
        isAdmin() || isSalesManager() ||
        (isEmployee() && request.resource.data.telecallerId == request.auth.uid)
      ) && request.resource.data.keys().hasAll(['id', 'telecallerId', 'timestamp']);

      // Immutability Protection: Telecaller cannot alter telecallerId, id, or leadId after creation
      allow update: if isAuthenticated() && (
        isAdmin() || isSalesManager() ||
        (isEmployee() && 
          resource.data.telecallerId == request.auth.uid &&
          request.resource.data.telecallerId == resource.data.telecallerId &&
          request.resource.data.id == resource.data.id &&
          (!('leadId' in resource.data) || request.resource.data.leadId == resource.data.leadId)
        )
      );
      allow delete: if isAdmin();
    }

    match /marketingLeads/{mktId} {
      allow read: if isAuthenticated() && (isAdmin() || isSalesManager());
      allow create, update, delete: if isAdmin();
    }

    // ==========================================
    // 4. QUOTATIONS: VERSION LOCKING & DISCOUNT CONTROL
    // ==========================================
    match /quotations/{quoteId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        isAccounts() || 
        isSalesManager() ||
        resource.data.createdBy == request.auth.uid ||
        resource.data.createdById == request.auth.uid ||
        (isDealer() && (resource.data.dealerId == request.auth.uid || resource.data.dealerCode == getUserDoc().dealerCode))
      );
      
      allow create: if isAuthenticated() && (
        isAdmin() || isSalesManager() || isEmployee() || isDealer()
      ) && (
        // Non-admins cannot create a quotation with pre-approved discount
        (!('discountApprovalStatus' in request.resource.data) || request.resource.data.discountApprovalStatus in ['None', 'Pending'] || isAdmin())
      );
      
      allow update: if isAuthenticated() && (
        // Admin or Accounts can approve/reject discount
        (isAdmin() && (
          resource.data.discountApprovalStatus != 'Approved' ||
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['grandTotal', 'discountAmount', 'items', 'systemCapacityKw'])
        )) ||
        // Creator can only edit unapproved drafts
        ((resource.data.createdBy == request.auth.uid || resource.data.createdById == request.auth.uid) && 
         resource.data.discountApprovalStatus in ['None', 'Pending'] &&
         request.resource.data.discountApprovalStatus in ['None', 'Pending'] &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
           'items', 'systemCapacityKw', 'inverterCapacity', 'panelWattage', 
           'notes', 'customerName', 'customerPhone', 'location', 'updatedAt',
           'subsidyAmount', 'customerPayable', 'quotationNumber', 'status',
           'discountRequested', 'discountAmount', 'discountReason', 'validUntil'
         ])
        )
      );
      
      allow delete: if isAdmin();
    }

    // ==========================================
    // 5. INVENTORY & DISPATCHES
    // ==========================================
    match /inventory/{itemId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isStockIncharge();
    }

    match /stockRequests/{reqId} {
      allow read: if isAuthenticated() && (isAdmin() || isStockIncharge() || resource.data.requesterId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update: if isAdmin() || isStockIncharge() || (
        resource.data.requesterId == request.auth.uid && 
        resource.data.status == 'Pending' &&
        request.resource.data.status == 'Pending'
      );
      allow delete: if isAdmin();
    }

    match /dealerStock/{stockId} {
      allow read: if isAuthenticated() && (isAdmin() || isStockIncharge() || resource.data.dealerId == request.auth.uid);
      allow write: if isAdmin() || isStockIncharge();
    }

    match /stockDispatches/{dispatchId} {
      allow read: if isAuthenticated() && (isAdmin() || isStockIncharge() || resource.data.dealerId == request.auth.uid);
      allow create: if isAdmin() || isStockIncharge();
      allow update: if isAdmin() || isStockIncharge() || (
        isDealer() && resource.data.dealerId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'acceptedAt', 'acceptedBy', 'rejectionReason', 'notes'
        ])
      );
      allow delete: if isAdmin();
    }

    match /materialConsumptions/{id} {
      allow read: if isAuthenticated() && (isAdmin() || isStockIncharge() || isEmployee());
      allow write: if isAdmin() || isStockIncharge();
    }

    match /materialReturns/{id} {
      allow read: if isAuthenticated() && (isAdmin() || isStockIncharge() || resource.data.dealerId == request.auth.uid);
      allow create: if isAuthenticated() && (isAdmin() || isStockIncharge() || isDealer());
      allow update, delete: if isAdmin() || isStockIncharge();
    }

    // ==========================================
    // 6. ACTIVITIES & TASKS
    // ==========================================
    match /activities/{actId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.user == request.auth.uid;
      allow update, delete: if false; // Append-only
    }

    match /tasks/{taskId} {
      allow read: if isAuthenticated() && (isAdmin() || isSalesManager() || resource.data.assignedToId == request.auth.uid);
      allow create: if isAuthenticated() && (isAdmin() || isSalesManager() || isEmployee());
      allow update: if isAdmin() || isSalesManager() || resource.data.assignedToId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ==========================================
    // 7. ATTENDANCE & PAYROLL
    // ==========================================
    match /attendance/{attId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /attendance_corrections/{corrId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /employee_leaves/{leaveId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /employee_salaries/{id} {
      allow read: if isAdmin() || isAccounts();
      allow write: if isAdmin();
    }

    match /employee_advances/{id} {
      allow read: if isAuthenticated() && (isAdmin() || isAccounts() || resource.data.employeeId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.employeeId == request.auth.uid;
      allow update, delete: if isAdmin() || isAccounts();
    }

    match /employee_payrolls/{id} {
      allow read: if isAuthenticated() && (isAdmin() || isAccounts() || resource.data.employeeId == request.auth.uid);
      allow write: if isAdmin() || isAccounts();
    }

    match /eod_reports/{reportId} {
      allow read: if isAuthenticated() && (isAdmin() || isSalesManager() || resource.data.employeeId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.employeeId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ==========================================
    // 8. SECURITY, AUDIT & IDEMPOTENCY
    // ==========================================
    match /ingested_events/{eventId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && (isAdmin() || isSalesManager());
      allow update, delete: if false; // Once written, immutable
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin() || isAccounts();
      allow create: if isAuthenticated() && (
        // Actor Identity Integrity: Caller UID must match actor ID in audit record
        (request.resource.data.userId == request.auth.uid ||
         request.resource.data.userUid == request.auth.uid ||
         request.resource.data.actorId == request.auth.uid) &&
        // Explicit Action Allowlist by Role (Anti-Forgery Positive Gate)
        (
          // Super Admin / Admin: authorized to log any operational or administrative action
          isAdmin() ||
          // Accounts: authorized to log payment verification and payroll audit actions
          (isAccounts() && request.resource.data.action in [
            'PAYMENT_VERIFIED', 'PAYMENT_REJECTED', 'PAYROLL_DISBURSED', 
            'PAYROLL_SAVED', 'LEDGER_ENTRY', 'QUOTATION_DISCOUNT_REVIEW',
            'ATTENDANCE_CHECK_IN', 'ATTENDANCE_CHECK_OUT', 'TASK_COMPLETED'
          ]) ||
          // Sales Manager: authorized for sales pipeline, lead assignment, and quotation logs
          (isSalesManager() && request.resource.data.action in [
            'LEAD_STAGE_CHANGED', 'LEAD_ASSIGNED', 'DEALER_ALLOCATION_REQUESTED',
            'QUOTATION_CREATED', 'QUOTATION_SENT', 'CUSTOMER_CONTACTED', 
            'CALL_LOGGED', 'ATTENDANCE_CHECK_IN', 'ATTENDANCE_CHECK_OUT', 'TASK_COMPLETED'
          ]) ||
          // Telecaller / Employee: authorized for operational customer interactions
          (isEmployee() && request.resource.data.action in [
            'CUSTOMER_CONTACTED', 'CALL_LOGGED', 'QUALIFICATION_COMPLETED',
            'ADVANCE_RECEIPT_UPLOADED', 'LEAD_STAGE_CHANGED', 'ATTENDANCE_CHECK_IN',
            'ATTENDANCE_CHECK_OUT', 'EOD_REPORT_SUBMITTED', 'TASK_COMPLETED'
          ]) ||
          // Regional Dealer: authorized for survey and installation milestones
          (isDealer() && request.resource.data.action in [
            'SITE_SURVEY_COMPLETED', 'SURVEY_PHOTOS_UPLOADED', 
            'INSTALLATION_MILESTONE_UPDATED', 'MATERIAL_RECEIPT_ACKNOWLEDGED'
          ])
        )
      );
      allow update, delete: if false; // Absolute immutability: tamper-proof
    }

    // ==========================================
    // 9. DEFAULT-DENY FALLBACK
    // ==========================================
  }
}
