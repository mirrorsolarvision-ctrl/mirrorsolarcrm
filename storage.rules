rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAllowedImageOrPdf() {
      return request.resource.contentType.matches('image/(jpeg|png|webp)') || 
             request.resource.contentType == 'application/pdf';
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'Admin' ||
        request.auth.token.email in ['mirrorsolarvision@gmail.com', 'mirroraquaro@gmail.com', 'balajiperuri09@gmail.com']
      );
    }

    // 1. Customer KYC & Identity Documents
    match /leads/{leadId}/documents/{docId}/{fileName} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && 
        isAllowedImageOrPdf() && 
        request.resource.size < 15 * 1024 * 1024;
      allow update, delete: if isAdmin(); // Only Admin can purge documents
    }

    // 2. Customer Payment Receipts & Proofs
    match /payments/{category}/{fileName} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && 
        isAllowedImageOrPdf() && 
        request.resource.size < 10 * 1024 * 1024;
      allow update, delete: if false; // Immutable payment records
    }

    // 3. Milestone Completion Proofs
    match /milestones/{fileName} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && 
        isAllowedImageOrPdf() && 
        request.resource.size < 15 * 1024 * 1024;
      allow update, delete: if isAdmin();
    }

    // 4. Attendance Check-in Selfies
    match /attendance/{userId}/{fileName} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && 
        request.auth.uid == userId &&
        request.resource.contentType.matches('image/(jpeg|png|webp)') && 
        request.resource.size < 5 * 1024 * 1024;
      allow update, delete: if false;
    }

    // 5. Public Company Branding (Protected from employee/dealer overwrites)
    match /branding/{fileName} {
      allow read: if true;
      allow write: if isAdmin(); // Strictly Admin-only
    }

    // --- NO CATCH-ALL WILDCARD ---
    // All other file paths are DENIED by default.
  }
}
