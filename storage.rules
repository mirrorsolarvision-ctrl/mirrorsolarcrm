rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAllowedImageOrPdf() {
      return request.resource.contentType.matches('image/(jpeg|png|webp)') || 
             request.resource.contentType == 'application/pdf';
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'Admin' ||
        request.auth.token.email in ['mirrorsolarvision@gmail.com', 'mirroraquaro@gmail.com', 'balajiperuri09@gmail.com']
      );
    }

    function isAccounts() {
      return isAuthenticated() && (
        request.auth.token.role == 'Accounts' ||
        request.auth.token.email in ['mirrorsolarvision@gmail.com', 'mirroraquaro@gmail.com', 'balajiperuri09@gmail.com']
      );
    }

    function isPrivilegedStaff() {
      return isAdmin() || isAccounts();
    }

    function isSuryaGharIncharge() {
      return isAuthenticated() && (
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.category in ['PM Surya Ghar Work Incharge', 'PM Surya Ghar'] ||
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.employeeCategory in ['PM Surya Ghar Work Incharge', 'PM Surya Ghar'] ||
        request.auth.token.email in ['kumari.suryaghar@mirrorsolar.in', 'kumari@mirrorsolar.in']
      );
    }

    function isAssignedStaffOrDealer(leadId) {
      let lead = firestore.get(/databases/(default)/documents/leads/$(leadId)).data;
      return isAuthenticated() && (
        isPrivilegedStaff() ||
        lead.assignedEmployeeId == request.auth.uid ||
        lead.leadOwnerId == request.auth.uid ||
        lead.dealerId == request.auth.uid ||
        lead.dealerCode == firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.dealerCode
      );
    }

    // 1a. Customer Sensitive Identity Documents (Aadhaar, Consent, Electricity Bill KYC):
    // Strictly restricted to Admin, Accounts, and PM Surya Ghar Incharge.
    // Authorized dealers and unassigned employees are strictly DENIED access to KYC identity files.
    match /leads/{leadId}/kyc/{docId}/{fileName} {
      allow read: if isPrivilegedStaff() || isSuryaGharIncharge() || (
        isAuthenticated() && 
        firestore.get(/databases/(default)/documents/leads/$(leadId)).data.assignedEmployeeId == request.auth.uid
      );
      allow create: if isAuthenticated() && 
        isAllowedImageOrPdf() && 
        request.resource.size < 15 * 1024 * 1024;
      allow update, delete: if isAdmin();
    }

    // 1b. Operational Documents (Rooftop Site Survey Photos, Roof Engineering Drawings):
    // Accessible by Admin, assigned sales staff, and the assigned authorized dealer.
    match /leads/{leadId}/documents/{docId}/{fileName} {
      allow read: if isAssignedStaffOrDealer(leadId);
      allow create: if isAuthenticated() && 
        isAllowedImageOrPdf() && 
        request.resource.size < 15 * 1024 * 1024;
      allow update, delete: if isAdmin(); // Strictly immutable against regular tampering
    }

    // 2. Customer Payment Receipts & Proofs:
    // Read access is strictly restricted to Admin and Accounts authority.
    match /payments/{category}/{fileName} {
      allow read: if isPrivilegedStaff();
      allow create: if isAuthenticated() && 
        isAllowedImageOrPdf() && 
        request.resource.size < 10 * 1024 * 1024;
      allow update, delete: if false; // Immutable payment records
    }

    // 3. Milestone Completion Proofs
    match /milestones/{fileName} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && 
        isAllowedImageOrPdf() && 
        request.resource.size < 15 * 1024 * 1024;
      allow update, delete: if isAdmin();
    }

    // 4. Attendance Check-in Selfies
    match /attendance/{userId}/{fileName} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isPrivilegedStaff());
      allow create: if isAuthenticated() && 
        request.auth.uid == userId &&
        request.resource.contentType.matches('image/(jpeg|png|webp)') && 
        request.resource.size < 5 * 1024 * 1024;
      allow update, delete: if false;
    }

    // 5. Public Company Branding
    match /branding/{fileName} {
      allow read: if true;
      allow write: if isAdmin(); // Strictly Super Admin
    }

    // --- NO CATCH-ALL WILDCARD ---
    // All other file paths are DENIED by default.
  }
}
