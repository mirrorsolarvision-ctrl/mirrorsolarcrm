{
  "name": "m-solar-crm",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test:security": "node tests/security_and_rbac_audit.mjs",
    "test:penetration": "node tests/direct_api_and_rules_penetration.mjs",
    "test:phase2_1": "node tests/phase2_1_verification.mjs",
    "test:gate2_1_r": "node tests/security_remediation_gate_2_1_r.mjs",
    "test:emulator": "firebase emulators:exec --only firestore,auth \"node tests/firebase_emulator_acceptance.mjs\"",
    "test:acceptance": "node tests/phase_2_sales_workflow_acceptance.mjs",
    "emulators": "npx firebase-tools emulators:start",
    "test:dr": "node scripts/executeFullDisasterRecoveryTest.mjs",
    "backup": "node scripts/backupFirestore.mjs",
    "backup:verify": "node scripts/restoreVerification.mjs",
    "deploy": "cmd /c scripts\\deploy.bat",
    "deploy:hosting": "cmd /c scripts\\deploy.bat --hosting",
    "deploy:rules": "cmd /c scripts\\deploy.bat --rules",
    "firebase:login": "npx firebase-tools login:use mirrorsolarvision@gmail.com",
    "firebase:status": "npx firebase-tools projects:list",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
